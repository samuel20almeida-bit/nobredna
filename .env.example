# Variáveis do site. Em produção elas vivem na Vercel, em
# Settings → Environment Variables do projeto `nobredna`.
#
# Sem as credenciais abaixo o site sobe e navega normalmente: o frete cai numa
# tabela de estimativa marcada como simulação, e o checkout monta o pedido sem
# cobrar, dizendo isso na tela. É proposital — melhor um aviso honesto que uma
# aprovação falsa.

# Mercado Pago — https://www.mercadopago.com.br/developers/panel/app
# Use a credencial de produção: em produção o código abre `init_point`,
# não o `sandbox_init_point`.
MERCADOPAGO_ACCESS_TOKEN=

# Melhor Envio — https://melhorenvio.com.br/painel/gerenciar/tokens
MELHOR_ENVIO_TOKEN=
# Sandbox para testar; troque por https://melhorenvio.com.br em produção.
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
# A API do Melhor Envio exige identificação com e-mail de contato.
MELHOR_ENVIO_USER_AGENT=NobreDNA Editorial (contato@nobredna.com.br)

# CEP de onde os livros são despachados. Este é o Centro de Curitiba, usado
# como referência até haver o endereço real de expedição — é ele que define a
# distância e, portanto, o preço de todo frete cotado no Melhor Envio.
ORIGEM_CEP=80010000

# URL pública do site — é para cá que o Mercado Pago devolve o cliente depois
# do pagamento. Precisa estar definida ANTES do build: por ser NEXT_PUBLIC_,
# ela é congelada no bundle, e mudá-la exige um novo deploy.
NEXT_PUBLIC_SITE_URL=https://nobredna.vercel.app

# Projeto Supabase dedicado à NobreDNA (somente chave publicável).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Manter desativado até confirmação das integrações e testes ponta a ponta.
ENABLE_LIVE_CHECKOUT=false
